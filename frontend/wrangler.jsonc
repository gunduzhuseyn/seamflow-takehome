// Cloudflare Worker that serves the Vite build as static assets. No Worker
// script runs. CI deploys it with `wrangler deploy`. See docs/guides/deploy.md.
{
  // The repository name. A copy changes it.
  "name": "seamflow-takehome",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist/",
    // Unknown paths return index.html, so React Router handles them.
    "not_found_handling": "single-page-application",
  },
}
