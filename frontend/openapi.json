  "components": {
    "schemas": {
      "CallStatus": {
        "type": "string",
        "enum": [
          "running",
          "succeeded",
          "failed",
          "invalid_output"
        ],
        "title": "CallStatus"
      },
      "ClassificationCreate": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Key"
          },
          "filename": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename"
          },
          "question_label": {
            "type": "string",
            "title": "Question Label",
            "default": "hot dog"
          }
        },
        "type": "object",
        "required": [
          "key",
          "filename"
        ],
        "title": "ClassificationCreate"
      },
      "ClassificationList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClassificationOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "ClassificationList"
      },
      "ClassificationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "submitted_by_name": {
            "type": "string",
            "title": "Submitted By Name"
          },
          "question_label": {
            "type": "string",
            "title": "Question Label"
          },
          "verdict_labels": {
            "$ref": "#/components/schemas/VerdictLabels"
          },
          "status": {
            "$ref": "#/components/schemas/ClassificationStatus"
          },
          "review_status": {
            "$ref": "#/components/schemas/ReviewStatus"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "observations": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observations"
          },
          "final_verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd"
          },
          "duplicate_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duplicate Of"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "updated_at",
          "filename",
          "submitted_by_name",
          "question_label",
          "verdict_labels",
          "status",
          "review_status",
          "verdict",
          "confidence",
          "observations",
          "final_verdict",
          "reviewed_at",
          "latency_ms",
          "cost_usd",
          "duplicate_of",
          "thumbnail_url",
          "error_code"
        ],
        "title": "ClassificationOut"
      },
      "ClassificationStatus": {
        "type": "string",
