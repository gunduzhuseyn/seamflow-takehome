# Runtime environment: development or production.
ENVIRONMENT=development
# Log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. DEBUG adds the /health lines.
# LOG_LEVEL=INFO
# Log format: json or text. Default: json in production, text in development.
# LOG_FORMAT=text
# Async SQLAlchemy URL of the development database in Compose.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Second Compose database. pytest only. Its schema is dropped and rebuilt each run.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test
# Redis in Compose.
REDIS_URL=redis://localhost:6379/0
# Browser origins allowed by CORS, comma-separated. Default is the Vite dev server.
CORS_ORIGINS=http://localhost:5173
# Clerk secret key of the shared development instance. Dashboard > Configure > API keys.
# The publishable key and the JWT public key are public. Their defaults are in backend/app/core/config.py.
CLERK_SECRET_KEY=sk_test_replace_me
# Allowed azp values of a session token, comma-separated. Default: CORS_ORIGINS.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Seed user. The seed creates it in Clerk on the first run. Clerk keeps the first password.
# Keep the +clerk_test sub-address: Clerk sends no email to it and accepts code 424242.
SEED_USER_EMAIL=replace-me+clerk_test@example.com
SEED_USER_PASSWORD=replace-me-with-a-long-password
# Anthropic API key of this copy's Console workspace. Console > API Keys.
ANTHROPIC_API_KEY=sk-ant-replace_me
# LLM settings and their defaults. LLM_PROVIDER=fake replays tests/fixtures/llm.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_INPUT_TOKEN_LIMIT=8000
# LLM_RATE_LIMIT_PER_MINUTE=10
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Worker settings and their defaults. Attempts per job, seconds per run, and the arq queue key.
# WORKER_MAX_ATTEMPTS=3
# WORKER_JOB_TIMEOUT_SECONDS=60
# WORKER_QUEUE_NAME=arq:queue
